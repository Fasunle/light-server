  "dependencies": {
    "dotenv": "^17.4.2",
    "find-my-way": "^9.6.0",
    "micro": "^10.0.1"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
