{
  "name": "test-server",
  "version": "1.0.0",
  "description": "A simple test server designed to check my vm deployment",
  "keywords": [
    "light-server"
  ],
  "homepage": "https://github.com/Fasunle/light-server#readme",
  "bugs": {
